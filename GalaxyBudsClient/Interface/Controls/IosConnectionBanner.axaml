<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GalaxyBudsClient.Interface.Controls"
             x:Class="GalaxyBudsClient.Interface.Controls.IosConnectionBanner"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top"
             MaxWidth="420"
             IsVisible="False">
    <!-- iOS design: the connection popup (BudsPopup on desktop) as a card that slides down over the header.
         MainView places it below the status bar; Show/Hide animate it in and out. -->
    <!-- The bottom margin leaves room for the shadow, which is clipped to the control's bounds otherwise -->
    <Border Name="Card"
            Margin="0,0,0,28"
            Background="{DynamicResource IosPopupBrush}"
            BorderBrush="{DynamicResource IosSeparatorBrush}"
            BorderThickness="0.5"
            CornerRadius="22"
            Padding="20,14,20,16"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" OffsetY="8" Color="#8C000000" />
        </Border.Effect>
        <Grid RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0"
                       Name="Header"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource IosTextBrush}"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />
            <controls:EarbudCompactStatusUnit Grid.Row="1"
                                              Height="122" />
        </Grid>
    </Border>
</UserControl>

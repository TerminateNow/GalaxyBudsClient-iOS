<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:vm="using:GalaxyBudsClient.Interface.ViewModels"
             xmlns:platform="clr-namespace:GalaxyBudsClient.Platform"
             xmlns:ext="clr-namespace:GalaxyBudsClient.Interface.MarkupExtensions"
             xmlns:i18N="clr-namespace:GalaxyBudsClient.Generated.I18N"
             xmlns:platUtils="clr-namespace:GalaxyBudsClient.Platform;assembly=GalaxyBudsClient.Platform"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="GalaxyBudsClient.Interface.MainView"
             x:DataType="vm:MainViewViewModel"
             x:CompileBindings="True">
    
    <Grid RowDefinitions="Auto,*">
        <Grid Name="TitleBarHost"
              ColumnDefinitions="*,Auto"
              Background="Transparent" />

        <ui:FANavigationView Grid.Row="0"
                           AlwaysShowHeader="False" 
                           IsPaneOpen="False"
                           PaneDisplayMode="Left"
                           Grid.RowSpan="2"
                           Name="NavView"
                           IsSettingsVisible="False"
                           IsBackEnabled="{Binding #FrameView.CanGoBack}">
            <Grid RowDefinitions="Auto,Auto,Auto,*"
                  Name="ContentContainer">

                <!-- iOS design: one header row right below the status bar. At the top of a page it shows the large
                     title (with the back chevron and the settings button); scrolled, it is shorter and shows the
                     small centered title instead (MainView.SetIosTitleCollapsed). -->
                <Grid Grid.Row="0"
                      Name="IosNavBar"
                      IsVisible="False"
                      Height="52"
                      ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Name="IosBackButton"
                            Classes="IosNavButton"
                            IsVisible="False"
                            Click="OnIosBackClicked">
                        <Path Data="M10 2L2 10l8 8"
                              Width="12" Height="20"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="2.6"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Name="IosLargeTitle"
                               IsVisible="False"
                               FontSize="32"
                               FontWeight="Bold"
                               LetterSpacing="-0.5"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="12,0,4,0" />
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                               Name="IosInlineTitle"
                               FontSize="17"
                               FontWeight="SemiBold"
                               MaxWidth="200"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0">
                        <TextBlock.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                            </Transitions>
                        </TextBlock.Transitions>
                    </TextBlock>
                    <Button Grid.Column="2"
                            Name="IosSettingsButton"
                            Classes="IosNavButton"
                            IsVisible="False"
                            Width="44"
                            Click="OnIosSettingsClicked">
                        <ic:SymbolIcon Symbol="Settings" FontSize="24" />
                    </Button>
                </Grid>

                <ui:FAInfoBar Grid.Row="1"
                            Name="DisconnectedInfoBar"
                            Title="{ext:Translate {x:Static i18N:Keys.PlacementDisconnected}}"
                            IsClosable="False"
                            Severity="Warning"
                            Message="{Binding LastErrorMessage, Source={x:Static platform:BluetoothImpl.Instance}}"
                            Margin="20,16,20,0">
                    <ui:FAInfoBar.IsOpen>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsConnected" Source="{x:Static platform:BluetoothImpl.Instance}" />
                            <Binding Path="!AlternativeModeEnabled" Source="{x:Static platform:BluetoothImpl.Instance}" />
                            <Binding Path="!IsInSetupWizard" />
                        </MultiBinding>
                    </ui:FAInfoBar.IsOpen>
                    <ui:FAInfoBar.ActionButton>
                        <StackPanel HorizontalAlignment="Right"
                                    Spacing="8"
                                    Orientation="Horizontal">
                            <Button Content="{ext:Translate {x:Static i18N:Keys.ConnlostTroubleshoot}}"
                                    HorizontalAlignment="Right"
                                    IsVisible="{Binding !., Source={x:Static platUtils:PlatformUtils.IsDesktop}}"
                                    Click="OnTroubleshootConnectionClicked"/>
                            
                            <Button Content="{Binding ConnectButtonText}"
                                    IsEnabled="{Binding IsConnectButtonEnabled}"
                                    HorizontalAlignment="Right">
                                <Interaction.Behaviors>
                                    <EventTriggerBehavior EventName="Click">
                                        <ext:EventDispatcherAction Event="Connect" />
                                    </EventTriggerBehavior>
                                </Interaction.Behaviors>
                            </Button>
                        </StackPanel>
                    </ui:FAInfoBar.ActionButton>
                </ui:FAInfoBar>

                <ui:FABreadcrumbBar Name="FABreadcrumbBar"
                                  MinHeight="56"
                                  Grid.Row="2"
                                  ItemsSource="{Binding BreadcrumbItems}"
                                  Margin="20,10">
                    <ui:FABreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="vm:BreadcrumbViewModel">
                            <ui:FABreadcrumbBarItem Content="{Binding Title}"
                                                  MinHeight="56" />
                        </DataTemplate>
                    </ui:FABreadcrumbBar.ItemTemplate>
                </ui:FABreadcrumbBar>

                <ui:FAFrame Grid.Row="3" Name="FrameView" />
            </Grid>
        </ui:FANavigationView>

    </Grid>

</UserControl>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.galaxybudsclient.budsrfcomm</string>
	<!-- the app chooses the device per connection (CONNECT); defaults and channels come from the settings file -->
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/bin/budsrfcomm</string>
		<string>daemon</string>
	</array>
	<!-- the same user the bridge was tested as over SSH; owns the settings file -->
	<key>UserName</key>
	<string>mobile</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/jb/var/mobile/Library/Logs/budsrfcomm.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/mobile/Library/Logs/budsrfcomm.log</string>
</dict>
</plist>
